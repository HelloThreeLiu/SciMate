{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scimate-spike",
  "version": "0.1.0",
  "identifier": "com.scimate.spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SciMate 打包验证 Spike",
        "width": 780,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/scimate-kernel"],
    "resources": {
      "../../kernel/pandoc/pandoc.exe": "pandoc/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
